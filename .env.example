# ==============================================================================
# Kickat E-Commerce Backend - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` and populate with actual credentials.
# NEVER commit the actual `.env` file containing secrets to version control.
# ==============================================================================

# Server Runtime
PORT=3000
NODE_ENV=development

# CORS Allowed Origins (Comma-separated list of web domains)
# Example for production: https://kickat.co.in,https://admin.kickat.co.in
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Connections (PostgreSQL / Supabase / Neon / AWS RDS)
# DATABASE_URL: Transaction pooler connection string (used in production for app queries)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# DIRECT_URL: Direct session connection string (used for Prisma migrations)
DIRECT_URL="postgresql://user:password@host:5432/postgres"
# Connection pool size (Default: 20)
DB_POOL_MAX=20

# JWT Authentication Secrets (Must be random, cryptographically secure 64+ char strings in production)
JWT_ACCESS_SECRET="generate_a_secure_random_string_for_access_tokens_in_production"
JWT_REFRESH_SECRET="generate_a_secure_random_string_for_refresh_tokens_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/callback/google"

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# SMTP Email Dispatcher (Gmail / SendGrid / Amazon SES / Brevo)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@domain.com"
SMTP_PASS="your_smtp_app_password"
SMTP_FROM="Kickat Pet Care <noreply@kickat.co.in>"
