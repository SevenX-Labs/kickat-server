generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OtpType {
  SMS
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum PetSpecies {
  DOG
  CAT
  BIRD
  FISH
  RABBIT
  OTHER
}

enum DietaryPreference {
  VEG
  NON_VEG
  BOTH
}

enum AgeUnit {
  MONTHS
  YEARS
}

enum WeightUnit {
  KG
  LBS
}

enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id                String         @id @default(uuid())
  email             String?        @unique
  phone             String?        @unique
  password          String?
  name              String?
  gender            Gender?
  dob               DateTime?
  isProfileComplete Boolean        @default(false)
  googleId          String?        @unique
  isEmailVerified   Boolean        @default(false)
  isPhoneVerified   Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  refreshTokens     RefreshToken[]
  addresses         Address[]
  pets              Pet[]
  recentSearches    RecentSearch[]
  wishlistItems     WishlistItem[]
  cartItems         CartItem[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  familyId  String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpLog {
  id         String   @id @default(uuid())
  identifier String
  otpHash    String
  type       OtpType
  expiresAt  DateTime
  attempts   Int      @default(0)
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@map("otp_logs")
}

model Address {
  id                   String      @id @default(uuid())
  userId               String
  type                 AddressType @default(HOME)
  houseFlat            String
  buildingStreet       String
  landmark             String?
  city                 String
  state                String
  country              String      @default("India")
  pincode              String
  isDefault            Boolean     @default(false)
  deliveryInstructions String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Pet {
  id                   String            @id @default(uuid())
  userId               String
  species              PetSpecies
  name                 String
  breed                String?
  dateOfBirth          DateTime?
  age                  Int?
  ageUnit              AgeUnit?
  dobOrAge             String?
  gender               Gender?
  weight               Float?
  weightUnit           WeightUnit        @default(KG)
  dietaryPreference    DietaryPreference?
  allergies            String[]          @default([])
  allergiesHealthNotes String?
  healthNotes          String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pets")
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  linkUrl   String?
  type      String   @default("HERO")
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  imageUrl  String?
  parentId  String?
  isActive  Boolean    @default(true)
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryToCategory")
  products  Product[]

  @@map("categories")
}

model Product {
  id                String             @id @default(uuid())
  name              String
  slug              String             @unique
  description       String?
  price             Float
  discountPrice     Float?
  stock             Int                @default(100)
  rating            Float              @default(4.5)
  reviewsCount      Int                @default(0)
  brand             String?
  petSpecies        PetSpecies?
  dietaryPreference DietaryPreference?
  categoryId        String
  isTrending        Boolean            @default(false)
  isBestSeller      Boolean            @default(false)
  imageUrl          String
  images            String[]           @default([])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants          ProductVariant[]
  media             ProductMedia[]
  reviews           ProductReview[]
  wishlistItems     WishlistItem[]
  cartItems         CartItem[]

  @@index([categoryId])
  @@index([petSpecies])
  @@map("products")
}

model ProductVariant {
  id            String         @id @default(uuid())
  productId     String
  name          String
  sku           String?
  price         Float
  stock         Int            @default(50)
  attributes    Json?
  imageUrl      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  wishlistItems WishlistItem[]
  cartItems     CartItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductMedia {
  id           String    @id @default(uuid())
  productId    String
  type         MediaType @default(IMAGE)
  url          String
  thumbnailUrl String?
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_media")
}

model ProductReview {
  id                 String   @id @default(uuid())
  productId          String
  userId             String?
  userName           String
  userAvatar         String?
  rating             Int
  title              String?
  comment            String
  photos             String[] @default([])
  isVerifiedPurchase Boolean  @default(true)
  helpfulCount       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([rating])
  @@map("product_reviews")
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  summary     String?
  coverImage  String?
  category    String?
  tags        String[] @default([])
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blog_posts")
}

model RecentSearch {
  id        String   @id @default(uuid())
  userId    String
  query     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("recent_searches")
}

model WishlistItem {
  id        String          @id @default(uuid())
  userId    String
  productId String
  variantId String?
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

model CartItem {
  id        String          @id @default(uuid())
  userId    String
  productId String
  variantId String?
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([userId, productId, variantId])
  @@index([userId])
  @@map("cart_items")
}