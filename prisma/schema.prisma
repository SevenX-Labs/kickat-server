generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OtpType {
  SMS
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum PetSpecies {
  DOG
  CAT
  BIRD
  FISH
  RABBIT
  OTHER
}

enum DietaryPreference {
  VEG
  NON_VEG
  BOTH
}

enum AgeUnit {
  MONTHS
  YEARS
}

enum WeightUnit {
  KG
  LBS
}

model User {
  id                String         @id @default(uuid())
  email             String?        @unique
  phone             String?        @unique
  password          String?
  name              String?
  gender            Gender?
  dob               DateTime?
  isProfileComplete Boolean        @default(false)
  googleId          String?        @unique
  isEmailVerified   Boolean        @default(false)
  isPhoneVerified   Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  refreshTokens     RefreshToken[]
  addresses         Address[]
  pets              Pet[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  familyId  String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpLog {
  id         String   @id @default(uuid())
  identifier String
  otpHash    String
  type       OtpType
  expiresAt  DateTime
  attempts   Int      @default(0)
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@map("otp_logs")
}

model Address {
  id                   String      @id @default(uuid())
  userId               String
  type                 AddressType @default(HOME)
  houseFlat            String
  buildingStreet       String
  landmark             String?
  city                 String
  state                String
  country              String      @default("India")
  pincode              String
  isDefault            Boolean     @default(false)
  deliveryInstructions String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Pet {
  id                   String            @id @default(uuid())
  userId               String
  species              PetSpecies
  name                 String
  breed                String?
  dateOfBirth          DateTime?
  age                  Int?
  ageUnit              AgeUnit?
  dobOrAge             String?
  gender               Gender?
  weight               Float?
  weightUnit           WeightUnit        @default(KG)
  dietaryPreference    DietaryPreference?
  allergies            String[]          @default([])
  allergiesHealthNotes String?
  healthNotes          String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pets")
}