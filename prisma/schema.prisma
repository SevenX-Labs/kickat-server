generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OtpType {
  SMS
  EMAIL
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum PetSpecies {
  DOG
  CAT
  BIRD
  FISH
  RABBIT
  OTHER
}

enum DietaryPreference {
  VEG
  NON_VEG
  BOTH
}

enum AgeUnit {
  MONTHS
  YEARS
}

enum WeightUnit {
  KG
  LBS
}

enum MediaType {
  IMAGE
  VIDEO
}

enum PaymentMethodEnum {
  UPI
  CARD
  WALLET
  NETBANKING
  COD
}

enum PaymentStatusEnum {
  PENDING
  COMPLETED
  FAILED
}

enum ProductStatusEnum {
  DRAFT
  ACTIVE
  INACTIVE
}

enum OrderStatusEnum {
  PENDING
  PLACED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  RETURN_INITIATED
}

model User {
  id                String             @id @default(uuid())
  email             String?            @unique
  phone             String?            @unique
  password          String?
  name              String?
  gender            Gender?
  dob               DateTime?
  isProfileComplete Boolean            @default(false)
  googleId          String?            @unique
  isEmailVerified   Boolean            @default(false)
  isPhoneVerified   Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  refreshTokens     RefreshToken[]
  addresses         Address[]
  pets              Pet[]
  recentSearches    RecentSearch[]
  wishlistItems     WishlistItem[]
  cartItems         CartItem[]
  stockReservations StockReservation[]
  orders            Order[]
  payments          Payment[]
  helpfulVotes      ReviewHelpful[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  recentlyViewed    RecentlyViewed[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  familyId  String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpLog {
  id         String   @id @default(uuid())
  identifier String
  otpHash    String
  type       OtpType
  expiresAt  DateTime
  attempts   Int      @default(0)
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@map("otp_logs")
}

model Address {
  id                   String      @id @default(uuid())
  userId               String
  type                 AddressType @default(HOME)
  houseFlat            String
  buildingStreet       String
  landmark             String?
  city                 String
  state                String
  country              String      @default("India")
  pincode              String
  isDefault            Boolean     @default(false)
  deliveryInstructions String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders               Order[]

  @@index([userId])
  @@map("addresses")
}

model Pet {
  id                   String            @id @default(uuid())
  userId               String
  species              PetSpecies
  name                 String
  breed                String?
  dateOfBirth          DateTime?
  age                  Int?
  ageUnit              AgeUnit?
  dobOrAge             String?
  gender               Gender?
  weight               Float?
  weightUnit           WeightUnit        @default(KG)
  dietaryPreference    DietaryPreference?
  allergies            String[]          @default([])
  allergiesHealthNotes String?
  healthNotes          String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pets")
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  imageUrl  String
  linkUrl   String?
  type      String   @default("HERO")
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  imageUrl  String?
  parentId  String?
  isActive  Boolean    @default(true)
  order     Int        @default(0)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryToCategory")
  products  Product[]

  @@map("categories")
}

model Product {
  id                String             @id @default(uuid())
  name              String
  slug              String             @unique
  description       String?
  price             Float
  discountPrice     Float?
  stock             Int                @default(100)
  rating            Float              @default(4.5)
  reviewsCount      Int                @default(0)
  brand             String?
  petSpecies        PetSpecies?
  dietaryPreference DietaryPreference?
  categoryId        String
  isTrending        Boolean            @default(false)
  isBestSeller      Boolean            @default(false)
  imageUrl          String
  images            String[]           @default([])
  status            ProductStatusEnum  @default(ACTIVE)
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants          ProductVariant[]
  media             ProductMedia[]
  reviews           ProductReview[]
  wishlistItems     WishlistItem[]
  cartItems         CartItem[]
  guestCartItems    GuestCartItem[]
  recentlyViewed    RecentlyViewed[]

  @@index([categoryId])
  @@index([petSpecies])
  @@map("products")
}

model ProductVariant {
  id            String          @id @default(uuid())
  productId     String
  name          String
  sku           String?
  price         Float
  stock         Int             @default(50)
  attributes    Json?
  imageUrl      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
  guestCartItems GuestCartItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductMedia {
  id           String    @id @default(uuid())
  productId    String
  type         MediaType @default(IMAGE)
  url          String
  thumbnailUrl String?
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_media")
}

model ProductReview {
  id                 String          @id @default(uuid())
  productId          String
  userId             String?
  orderId            String?
  userName           String
  userAvatar         String?
  rating             Int
  title              String?
  comment            String
  photos             String[]        @default([])
  isVerifiedPurchase Boolean         @default(true)
  helpfulCount       Int             @default(0)
  deletedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  product            Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  helpfulVotes       ReviewHelpful[]

  @@index([orderId, productId])
  @@index([productId])
  @@map("product_reviews")
}

model ReviewHelpful {
  id        String        @id @default(uuid())
  reviewId  String
  userId    String
  createdAt DateTime      @default(now())
  review    ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@map("review_helpful_votes")
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  summary     String?
  coverImage  String?
  category    String?
  tags        String[] @default([])
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blog_posts")
}

model RecentSearch {
  id        String   @id @default(uuid())
  userId    String
  query     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("recent_searches")
}

model WishlistItem {
  id        String          @id @default(uuid())
  userId    String
  productId String
  variantId String?
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

model CartItem {
  id        String          @id @default(uuid())
  userId    String
  productId String
  variantId String?
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([userId, productId, variantId])
  @@index([userId])
  @@map("cart_items")
}

model GuestCartItem {
  id        String          @id @default(uuid())
  sessionId String
  productId String
  variantId String?
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([sessionId, productId, variantId])
  @@index([sessionId])
  @@map("guest_cart_items")
}

model StockReservation {
  id          String   @id @default(uuid())
  userId      String
  expiresAt   DateTime
  isFulfilled Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("stock_reservations")
}

model Order {
  id                   String            @id @default(uuid())
  orderNumber          String            @unique
  userId               String
  addressId            String
  paymentMethod        PaymentMethodEnum
  paymentStatus        PaymentStatusEnum @default(PENDING)
  orderStatus          OrderStatusEnum   @default(PLACED)
  subtotal             Float
  deliveryFee          Float             @default(0)
  grandTotal           Float
  idempotencyKey       String?           @unique
  deliveryDate         DateTime?
  deliverySlot         String?
  deliveryInstructions String?
  cancelReason         String?
  cancelReasonOther    String?
  cancelledAt          DateTime?
  trackingNumber       String?
  courierPartner       String?
  estimatedDelivery    DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  address              Address           @relation(fields: [addressId], references: [id], onDelete: Restrict)
  items                OrderItem[]
  payments             Payment[]
  returns              OrderReturn[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id          String            @id @default(uuid())
  orderId     String
  productId   String
  variantId   String?
  quantity    Int
  price       Float
  totalPrice  Float
  productName String
  variantName String?
  createdAt   DateTime          @default(now())
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnItems OrderReturnItem[]

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                String            @id @default(uuid())
  orderId           String
  userId            String
  amount            Float
  currency          String            @default("INR")
  paymentMethod     PaymentMethodEnum
  status            PaymentStatusEnum @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  idempotencyKey    String?           @unique
  upiId             String?
  savedCardId       String?
  walletProvider    String?
  bankCode          String?
  saveCard          Boolean?          @default(false)
  failureReason     String?
  attempts          Int               @default(1)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
  @@map("payments")
}

model OrderReturn {
  id                 String            @id @default(uuid())
  orderId            String
  userId             String
  pickupInstructions String?
  status             String            @default("INITIATED")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items              OrderReturnItem[]

  @@index([orderId])
  @@index([userId])
  @@map("order_returns")
}

model OrderReturnItem {
  id          String      @id @default(uuid())
  returnId    String
  orderItemId String
  reason      String
  reasonOther String?
  photos      String[]    @default([])
  orderReturn OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([orderItemId])
  @@map("order_return_items")
}

model WebhookLog {
  id          String    @id @default(uuid())
  eventId     String    @unique
  event       String
  payload     Json
  status      String    @default("SUCCESS")
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("webhook_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ip        String?
  userAgent String?
  requestId String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model NotificationLog {
  id                String   @id @default(uuid())
  channel           String
  recipient         String
  templateCode      String?
  status            String
  error             String?
  providerMessageId String?
  retryCount        Int      @default(0)
  sentAt            DateTime @default(now())

  @@map("notification_logs")
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  code      String   @unique
  title     String
  body      String
  subject   String?
  channel   String   @default("EMAIL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_templates")
}

model RecentlyViewed {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("recently_viewed")
}

model Admin {
  id          String            @id @default(uuid())
  adminId     String            @unique
  name        String
  email       String            @unique
  password    String
  role        String            @default("ADMIN")
  permissions String[]          @default(["ALL"])
  isActive    Boolean           @default(true)
  isBlocked   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  sessions    AdminSession[]
  resetTokens AdminResetToken[]

  @@map("admins")
}

model AdminSession {
  id               String   @id @default(uuid())
  adminId          String
  refreshTokenHash String   @unique
  ipAddress        String?
  userAgent        String?
  isRevoked        Boolean  @default(false)
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  admin            Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}

model AdminResetToken {
  id             String    @id @default(uuid())
  adminId        String
  otpHash        String?
  resetToken     String?   @unique
  isOtpVerified  Boolean   @default(false)
  isUsed         Boolean   @default(false)
  otpExpiresAt   DateTime?
  tokenExpiresAt DateTime?
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  admin          Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, createdAt])
  @@map("admin_reset_tokens")
}